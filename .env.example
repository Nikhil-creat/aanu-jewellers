DATABASE_URL=postgres://user:pass@host/db      # Neon / Supabase / Render Postgres
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=long-random-string
GROQ_API_KEY=gsk_...                           # free key from console.groq.com (server side only)
CRON_SECRET=another-random-string
CORS_ORIGIN=                                   # only if the front-end is on a different domain
ML_URL=                                        # e.g. http://ml:8000 (visual search service, optional)
